{
  "name": "@tracelet/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tracelet 远程存储 / 协同服务端：REST API（Hono）+ PostgreSQL（Drizzle）或文件存储",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@tracelet/db": "workspace:*",
    "@tracelet/kernel": "workspace:*",
    "drizzle-orm": "^0.36.1",
    "hono": "^4.6.12",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
